# App config
APP_NAME=API
DEBUG_MODE=0
HOST_ADDRESS=0.0.0.0
BIND_PORT=5000
DATETIME_FORMAT=%Y-%m-%dT%H:%M:%S
JSON_SCHEMA_FOLDER_PATH=./src/sample-data-schemas
MAX_SAMPLES=5

# Gunicorn config
GUNICORN_WORKER_CLASS=eventlet
GUNICORN_NUM_WORKERS=1
GUNICORN_LOG_LEVEL=info
GUNICORN_KEEPALIVE=5
GUNICORN_TIMEOUT=30

# Interface and DB URIs
DB_URI=sqlite:///app/test/db/test.db
CAMERA_INTERFACE_URL=http://localhost:3000
AI_INTERFACE_URL=http://localhost:6000
